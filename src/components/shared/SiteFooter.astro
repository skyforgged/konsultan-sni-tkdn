---
import {siteConfig} from '../../config/site';
const { ariaLabel = 'Navigasi footer', brandCopy } = Astro.props;
---
<footer class="tkdn-site-footer site-footer" aria-label={ariaLabel}>
  <div class="container footer-grid tkdn-site-footer__inner">
    <div class="footer-brand">
  <a class="tkdn-site-brand brand brand-light" href="/">
    <span class="tkdn-site-brand__mark brand-mark" aria-hidden="true">S<span>+</span></span>
    <span class="brand-copy"><strong>Konsultan</strong><small>{siteConfig.brandTagline}</small></span>
  </a>
  {brandCopy
    ? (Array.isArray(brandCopy) ? brandCopy.map(p => <p>{p}</p>) : <p>{brandCopy}</p>)
    : siteConfig.footerCopyParagraphs.map(p => <p>{p}</p>)}
</div>
    <div class="footer-services" aria-label="Layanan"><h2>Layanan</h2><ul>{siteConfig.services.map(n=><li><a href={n.href}>{n.label}</a></li>)}</ul></div>
    <div class="footer-explore" aria-label="Jelajahi"><h2>Jelajahi</h2><ul><li><a href="/artikel/">Artikel</a></li><li><a href="/panduan/">Panduan</a></li><li><a href="/tentang-kami/">Tentang Kami</a></li><li><a href="/kontak/">Kontak</a></li><li><a href="/faq/">FAQ</a></li></ul></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {siteConfig.name}.</p></div>
</footer>
