---
/** Small reusable status/category label. */
const { variant = 'default', size = 'md' } = Astro.props as { variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info'; size?: 'sm' | 'md' };
const variants = { default:'neutral', primary:'primary', success:'success', warning:'warning', danger:'danger', info:'info' };
---
<span class={`tkdn-badge tkdn-badge--${variants[variant] ?? 'neutral'} tkdn-badge--${size === 'sm' ? 'sm' : 'md'}`}><slot /></span>
<style>
.tkdn-badge{display:inline-flex;align-items:center;width:fit-content;border-radius:999px;font-weight:800;line-height:1.5}.tkdn-badge--sm{padding:.15rem .5rem;font-size:.68rem}.tkdn-badge--md{padding:.25rem .7rem;font-size:.78rem}.tkdn-badge--neutral{background:#e8ede7;color:#43574a}.tkdn-badge--primary{background:#e7efdd;color:var(--forest)}.tkdn-badge--success{background:#dff3df;color:#205a36}.tkdn-badge--warning{background:#fff0cc;color:#79500a}.tkdn-badge--danger{background:#fce4e1;color:#8b2e24}.tkdn-badge--info{background:#dff1f2;color:#185d62}
</style>
