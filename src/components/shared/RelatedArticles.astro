---
const { items = [], heading = 'Bacaan yang relevan' } = Astro.props;
---
{items.length > 0 && <section class="tkdn-related-articles tkdn-block" aria-label={heading}>
  <h2 class="tkdn-block__title">{heading}</h2>
  <ul>{items.map(item => <li><a href={item.href}>{item.title}<span aria-hidden="true"> →</span></a>{item.description && <p>{item.description}</p>}</li>)}</ul>
</section>}
<style>.tkdn-related-articles ul{display:grid;gap:.7rem;list-style:none;padding:0;margin:0}.tkdn-related-articles li{padding:1rem;border:1px solid var(--line);border-radius:.8rem}.tkdn-related-articles li>a{font-weight:850;color:var(--forest)}.tkdn-related-articles li>p{margin:.35rem 0 0;color:var(--muted);font-size:.9rem}</style>
