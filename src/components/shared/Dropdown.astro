---
const { label = 'Pilihan lain', align = 'right' } = Astro.props;
---
<details class={`tkdn-dropdown tkdn-dropdown--${align === 'left' ? 'left' : 'right'}`}>
  <summary>{label}<span aria-hidden="true">⌄</span></summary>
  <div class="tkdn-dropdown__menu"><slot /></div>
</details>
<style>
.tkdn-dropdown{position:relative;display:inline-block}.tkdn-dropdown summary{display:flex;align-items:center;gap:.8rem;list-style:none;cursor:pointer;padding:.7rem 1rem;border:1px solid var(--line);border-radius:999px;background:white;color:var(--forest);font-size:.85rem;font-weight:800}.tkdn-dropdown summary::-webkit-details-marker{display:none}.tkdn-dropdown__menu{position:absolute;top:calc(100% + .5rem);z-index:30;min-width:14rem;padding:.65rem;border:1px solid var(--line);border-radius:1rem;background:white;box-shadow:var(--shadow)}.tkdn-dropdown--right .tkdn-dropdown__menu{right:0}.tkdn-dropdown--left .tkdn-dropdown__menu{left:0}.tkdn-dropdown__menu :global(a){display:block;padding:.65rem .75rem;border-radius:.5rem;color:var(--ink);font-size:.85rem}.tkdn-dropdown__menu :global(a:hover){background:#f0f4eb}
</style>
