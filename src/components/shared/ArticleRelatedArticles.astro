---
import ArticleCard from './ArticleCard.astro';

type RelatedArticle = {
  id?: string | number;
  slug?: string;
  data?: {
    id?: string | number;
    slug?: string;
    title?: string;
    description?: string;
    category?: string;
    pubDate?: Date | string;
  };
};

const { articles = [], relatedIds = [], heading = 'Artikel terkait' } = Astro.props as {
  articles?: RelatedArticle[];
  relatedIds?: Array<string | number>;
  heading?: string;
};

const selected = relatedIds
  .map((id) => articles.find((article) => {
    const candidateId = article.data?.id ?? article.id;
    const candidateSlug = article.data?.slug ?? article.slug;
    return String(candidateId ?? candidateSlug) === String(id);
  }))
  .filter((article): article is RelatedArticle => Boolean(article));
---
{selected.length > 0 && <section class="tkdn-related" aria-label={heading}>
  <h2 class="tkdn-block__title">{heading}</h2>
  <div class="tkdn-related__grid">{selected.map((article) => <ArticleCard article={article} />)}</div>
</section>}
<style>.tkdn-related{margin:2rem 0}.tkdn-related__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:1rem}</style>
