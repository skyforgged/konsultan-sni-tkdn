---
import {getCollection} from 'astro:content';
interface Props {
  services?: string[];
  pages?: string[];
  articles?: string[];
  guides?: string[];
  currentSlug?: string;
  title?: string;
}
const {services=[],pages=[],articles=[],guides=[],currentSlug='',title='Konten terkait'}=Astro.props;
const [serviceEntries,pageEntries,articleEntries,guideEntries]=await Promise.all([
  getCollection('services',({data})=>!data.draft && data.status==='active'),
  getCollection('pages',({data})=>!data.draft && data.status==='active'),
  getCollection('articles',({data})=>!data.draft && data.status==='active'),
  getCollection('guides',({data})=>!data.draft && data.status==='active'),
]);
const groups=[
  {label:'Layanan terkait',items:services.map(slug=>{const e=serviceEntries.find(x=>x.slug===slug||x.id===slug);return e?{title:e.data.title,description:e.data.description,href:`/layanan/${e.slug??e.id}/`}:null;}).filter((item): item is NonNullable<typeof item> => item !== null)},
  {label:'Halaman terkait',items:pages.map(slug=>{const e=pageEntries.find(x=>x.slug===slug||x.id===slug);return e?{title:e.data.title,description:e.data.description,href:e.data.canonical??(slug==='home'?'/':`/${e.slug??e.id}/`)}:null;}).filter((item): item is NonNullable<typeof item> => item !== null)},
  {label:'Artikel terkait',items:articles.map(slug=>{const e=articleEntries.find(x=>x.slug===slug||x.id===slug);return e?{title:e.data.title,description:e.data.description,href:`/artikel/${e.slug??e.id}/`}:null;}).filter((item): item is NonNullable<typeof item> => item !== null)},
  {label:'Panduan terkait',items:guides.map(slug=>{const e=guideEntries.find(x=>x.slug===slug||x.id===slug);return e?{title:e.data.title,description:e.data.description,href:`/panduan/${e.slug??e.id}/`}:null;}).filter((item): item is NonNullable<typeof item> => item !== null)},
].map(g=>({...g,items:g.items.filter(i=>i.href!==currentSlug)})).filter(g=>g.items.length);
const unresolved = [
  ...services.filter(slug=>!serviceEntries.some(e=>e.slug===slug||e.id===slug)).map(slug=>`service:${slug}`),
  ...pages.filter(slug=>!pageEntries.some(e=>e.slug===slug||e.id===slug)).map(slug=>`page:${slug}`),
  ...articles.filter(slug=>!articleEntries.some(e=>e.slug===slug||e.id===slug)).map(slug=>`article:${slug}`),
  ...guides.filter(slug=>!guideEntries.some(e=>e.slug===slug||e.id===slug)).map(slug=>`guide:${slug}`),
];
if(unresolved.length) throw new Error(`Invalid related-content frontmatter: ${unresolved.join(', ')}`);
---
{groups.length>0&&<aside class="article-aside related-content"><h2>{title}</h2>{groups.map(group=><div class="related-group"><h3>{group.label}</h3>{group.items.map(item=><a href={item.href}><strong>{item.title}</strong><small>{item.description}</small><span aria-hidden="true">→</span></a>)}</div>)}</aside>}
