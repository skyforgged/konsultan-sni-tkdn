---
import {siteConfig} from '../config/site';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import '../styles/global.css';
interface Props {title:string;description:string;image?:string;canonical?:string;type?:'website'|'article';noindex?:boolean}
const {title,description,image=siteConfig.socialImage,canonical:canonicalOverride,type='website',noindex=false}=Astro.props;
const pageTitle=title===siteConfig.name||title.includes(siteConfig.name)?title:`${title} | ${siteConfig.name}`;
const pageUrl=Astro.site?new URL(Astro.url.pathname,Astro.site).toString():undefined;
const canonical=Astro.site&&!noindex?new URL(canonicalOverride??Astro.url.pathname,Astro.site).toString():undefined;
const socialImagePath=image.endsWith('.svg')?image.slice(0,-4)+'.webp':image;
const socialImage=socialImagePath.startsWith('http')?socialImagePath:(Astro.site?new URL(socialImagePath,Astro.site).toString():undefined);
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content={Astro.generator}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/x-icon" href="/favicon.ico"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><title>{pageTitle}</title><meta name="description" content={description}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta name="robots" content={noindex?'noindex,nofollow':'index,follow,max-image-preview:large'}/><meta name="theme-color" content="#12372d"/><meta property="og:type" content={type}/><meta property="og:locale" content={siteConfig.locale}/><meta property="og:site_name" content={siteConfig.name}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>{(canonical??pageUrl)&&<meta property="og:url" content={canonical??pageUrl}/>}{socialImage&&<meta property="og:image" content={socialImage}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/>{socialImage&&<meta name="twitter:image" content={socialImage}/>}<slot name="head"/></head><body><a class="skip-link" href="#konten">Lewati ke konten utama</a><SiteHeader/><main id="konten"><slot/></main><SiteFooter/></body></html>
