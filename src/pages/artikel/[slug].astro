---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import {markdownToBlocks} from '../../utils/markdownToBlocks';
export async function getStaticPaths(){const entries=await getCollection('articles',({data})=>!data.draft&&data.status==='active');return entries.map(entry=>({params:{slug:entry.slug??entry.id.replace(/\.md$/, '')},props:{entry}}))}
const {entry}=Astro.props;
const blocks=entry.data.blocks.length?entry.data.blocks:markdownToBlocks(entry.body??'');
const renderedBlocks=blocks.length?blocks:[{component:'section',heading:'Ringkasan',content:[{text:entry.data.description}]}];
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.socialImage??entry.data.image} canonical={entry.data.canonical}>
  <article>
    <header class="content-hero"><div class="container">
      <p class="breadcrumbs"><a href="/">Beranda</a> / <a href="/artikel/">Artikel</a> / {entry.data.title}</p>
      <p class="section-kicker">{entry.data.category??'ARTIKEL EDUKASI'}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p>
      <p class="article-meta">Diterbitkan {new Date(entry.data.pubDate).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})} · {entry.data.author}</p>
    </div></header>
    <section class="section"><div class="container content-layout">
      <div class="prose component-article-content">{renderedBlocks.map(block=><BlockRenderer block={block}/>)}
        <aside class="tkdn-block tkdn-block--note"><h2 class="tkdn-block__title">Catatan editorial</h2><p>Artikel ini bersifat edukatif. Periksa sumber resmi untuk memastikan ketentuan yang berlaku bagi kasus Anda.</p><a class="button" href="/kontak/">Diskusikan kebutuhan ↗</a></aside>
      </div>
      <RelatedLinks services={entry.data.relatedServices} pages={entry.data.relatedPages} articles={entry.data.relatedArticles} guides={entry.data.relatedGuides} currentSlug={Astro.url.pathname} title="Lanjutkan membaca"/>
    </div></section>
  </article>
</BaseLayout>
