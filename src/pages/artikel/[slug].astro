---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){const entries=await getCollection('articles',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id.replace(/\.md$/, '')},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.image}><article><header class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / <a href="/artikel/">Artikel</a> / {entry.data.title}</p><p class="section-kicker">{entry.data.category??'ARTIKEL EDUKASI'}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="article-meta">Diterbitkan {entry.data.publishDate.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})} · {entry.data.author}</p></div></header><section class="section"><div class="container content-layout"><div class="prose"><Content/><hr style="border:0;border-top:1px solid var(--line);margin:45px 0"/><p>Artikel ini bersifat edukatif. Periksa sumber resmi untuk memastikan ketentuan yang berlaku bagi kasus Anda.</p><a class="button" href="/kontak/">Diskusikan kebutuhan ↗</a></div><aside class="article-aside"><h2>Konten terkait</h2><a href="/panduan/">Panduan praktis →</a><a href="/layanan/">Jelajahi layanan →</a><a href="/faq/">Pertanyaan umum →</a></aside></div></section></article></BaseLayout>
