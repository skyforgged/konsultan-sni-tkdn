---
import {getCollection,getEntry} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
const page=await getEntry('pages','artikel');
if(!page) throw new Error('Missing frontmatter source: pages/artikel.md');
const entries=(await getCollection('articles',({data})=>!data.draft&&data.status!=='inactive')).sort((a,b)=>(b.data.pubDate??b.data.publishDate).valueOf()-(a.data.pubDate??a.data.publishDate).valueOf());
---
<BaseLayout title={page.data.title} description={page.data.description} image={page.data.socialImage} canonical={page.data.canonical}>
<section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / Artikel</p><p class="section-kicker">PUSAT PENGETAHUAN</p><h1>{page.data.heroTitle}</h1><p class="lead">{page.data.heroIntro}</p><div class="hero-actions"><a class="button" href="/artikel/">Artikel</a><a class="button button-outline" href="/panduan/">Panduan praktis →</a></div></div></section>
<section class="section"><div class="container">{entries.length?<div class="article-grid">{entries.map(e=><a class="article-card" href={`/artikel/${e.data.slug??e.id}/`}><div class="article-card-body"><p class="article-tag">{e.data.category??'Edukasi'} · {(e.data.pubDate??e.data.publishDate).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})}</p><h3>{e.data.title}</h3><p>{e.data.description}</p><span class="text-link">Baca artikel →</span></div></a>)}</div>:<p class="empty-state">Artikel sedang disiapkan.</p>}<div style="margin-top:35px"><RelatedLinks services={page.data.relatedServices} pages={page.data.relatedPages} guides={page.data.relatedGuides} title="Layanan dan panduan terkait"/></div></div></section>
</BaseLayout>
