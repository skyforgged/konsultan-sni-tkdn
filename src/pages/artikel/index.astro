---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';
const entries=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="Artikel SNI, TKDN, dan BMP" description="Artikel edukasi tentang SNI, TKDN, BMP, persiapan dokumen, dan proses pendampingan."><section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / Artikel</p><p class="section-kicker">PUSAT PENGETAHUAN</p><h1>Artikel untuk memahami konteks dan pilihan.</h1><p class="lead">Penjelasan dan wawasan untuk membantu tim memahami istilah, peran, serta pertanyaan umum seputar persiapan SNI, TKDN, dan BMP.</p><div class="hero-actions"><a class="button" href="/artikel/">Artikel</a><a class="button button-outline" href="/panduan/">Panduan praktis →</a></div></div></section><section class="section"><div class="container">{entries.length?<div class="article-grid">{entries.map(e=><a class="article-card" href={`/artikel/${e.id.replace(/\.md$/, '')}/`}><div class="article-card-body"><p class="article-tag">{e.data.category??'Edukasi'} · {e.data.publishDate.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})}</p><h3>{e.data.title}</h3><p>{e.data.description}</p><span class="text-link">Baca artikel →</span></div></a>)}</div>:<p class="empty-state">Artikel sedang disiapkan.</p>}</div></section></BaseLayout>
