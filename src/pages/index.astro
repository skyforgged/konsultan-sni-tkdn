---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import {getCollection,getEntry} from 'astro:content';
const home = await getEntry('pages','home.md');
if (!home) throw new Error('Missing frontmatter source: src/content/pages/home.md');
const pageData = home.data;
const serviceEntries = (await getCollection('services',({data})=>!data.draft && data.status==='active')).sort((a,b)=>(a.data.order??999)-(b.data.order??999));
const services = serviceEntries.map((entry,i)=>({title:entry.data.title,description:entry.data.description,href:`/layanan/${entry.slug??entry.id}/`,eyebrow:entry.data.eyebrow,number:String(i+1).padStart(2,'0')}));
---
<BaseLayout title={pageData.title} description={pageData.description} image={pageData.socialImage} canonical={pageData.canonical}><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">{pageData.heroEyebrow}</p><h1>{pageData.heroTitle}</h1><p class="hero-lead">{pageData.heroIntro}</p><div class="hero-actions"><a class="button button-light" href="/kontak/">Diskusikan kebutuhan Anda ↗</a><a class="button" href="/layanan/" style="background:transparent;border-color:#ffffff55">Jelajahi layanan →</a></div><div class="hero-proof"><span class="proof-dot"></span><span>{pageData.heroProof}</span></div></div><div class="hero-visual" role="img" aria-label="Ilustrasi konsep SNI, TKDN, dan BMP"><div class="orbit"></div><div class="orbit orbit-two"></div><div class="visual-core"><strong>SNI+</strong><small>READY WITH CLARITY</small></div><div class="floating-note note-one">Dokumen tertata<small>Lebih mudah ditinjau</small></div><div class="floating-note note-two">Langkah terpetakan<small>Prioritas lebih jelas</small></div></div></div></section><section class="section"><div class="container"><div class="section-heading"><div><p class="section-kicker">LAYANAN KAMI</p><h2>{pageData.servicesTitle}</h2></div><p>{pageData.servicesIntro}</p></div><div class="service-grid">{services.map(s=><ServiceCard {...s}/>)}</div></div></section><section class="section section-white"><div class="container value-grid"><div class="value-intro"><p class="section-kicker">KENAPA MEMILIH KAMI</p><h2>{pageData.benefitsTitle}</h2><p>{pageData.benefitsIntro}</p><a class="text-link" href="/tentang-kami/">{pageData.benefitsLinkLabel}</a></div><div class="value-list">{pageData.benefits.map((b,i)=><article class="value-item"><span class="value-icon">{String(i+1).padStart(2,"0")}</span><h3>{b.title}</h3><p>{b.text}</p></article>)}</div></div></section><section class="section section-dark"><div class="container"><div class="section-heading"><div><p class="section-kicker">PROSES KERJA</p><h2>{pageData.processTitle}</h2></div><p>{pageData.processIntro}</p></div><div class="process-grid">{pageData.process.map((p,i)=><article class="process-step"><span class="process-num">{String(i+1).padStart(2,"0")}</span><h3>{p.title}</h3><p>{p.description}</p></article>)}</div></div></section><section class="section"><div class="container"><RelatedLinks articles={pageData.relatedArticles} guides={pageData.relatedGuides} title="Artikel dan panduan untuk langkah berikutnya"/></div></section><section class="section"><div class="container"><div class="cta-band"><div><p class="section-kicker">{pageData.ctaEyebrow}</p><h2>{pageData.ctaTitle}</h2><p>{pageData.ctaIntro}</p></div><a class="button" href="/kontak/">{pageData.ctaButtonLabel}</a></div></div></section></BaseLayout>
