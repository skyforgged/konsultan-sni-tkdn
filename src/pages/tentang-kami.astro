---
import {getEntry,render} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
const entry=await getEntry('pages','tentang-kami.md');
if(!entry) throw new Error('Missing frontmatter source: pages/tentang-kami.md');
const {Content}=await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.socialImage} canonical={entry.data.canonical}>
<section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / {entry.data.title}</p><p class="section-kicker">{entry.data.navLabel??'TENTANG KAMI'}</p><h1>{entry.data.heroTitle}</h1><p class="lead">{entry.data.heroIntro}</p></div></section>
<section class="section"><div class="container content-layout"><article class="prose"><Content/><a class="button" href="/kontak/">Diskusikan kebutuhan ↗</a></article><RelatedLinks services={entry.data.relatedServices} pages={entry.data.relatedPages} articles={entry.data.relatedArticles} guides={entry.data.relatedGuides} currentSlug={Astro.url.pathname} title="Jelajahi konten terkait"/></div></section>
</BaseLayout>
