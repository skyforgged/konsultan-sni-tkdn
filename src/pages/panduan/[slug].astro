---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import HowTo from '../../components/HowTo.astro';import RelatedLinks from '../../components/RelatedLinks.astro';
export async function getStaticPaths(){const entries=await getCollection('guides',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.slug??entry.id.replace(/\.md$/, '')},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article" image={entry.data.socialImage??entry.data.image} canonical={entry.data.canonical}><article><header class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / <a href="/panduan/">Panduan</a> / {entry.data.title}</p><p class="section-kicker">{entry.data.category??'PANDUAN PRAKTIS'}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="article-meta">Diterbitkan {new Date(entry.data.pubDate).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})} · {entry.data.author}</p></div></header><section class="section"><div class="container content-layout"><div class="prose">{entry.data.howTo&&<HowTo {...entry.data.howTo}/>}<Content/><hr style="border:0;border-top:1px solid var(--line);margin:45px 0"/><p>Gunakan panduan ini sebagai titik awal. Verifikasi persyaratan untuk produk atau pengajuan spesifik sebelum mengambil keputusan.</p><a class="button" href="/kontak/">Diskusikan langkah berikutnya ↗</a></div><RelatedLinks services={entry.data.relatedServices} pages={entry.data.relatedPages} articles={entry.data.relatedArticles} guides={entry.data.relatedGuides} currentSlug={Astro.url.pathname} title="Langkah selanjutnya"/></div></section></article></BaseLayout>