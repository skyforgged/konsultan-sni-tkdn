---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';
const entries=(await getCollection('guides',({data})=>!data.draft)).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="Panduan Praktis SNI, TKDN, dan BMP" description="Panduan langkah demi langkah untuk menyiapkan informasi dan dokumen awal terkait SNI, TKDN, dan BMP."><section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / Panduan</p><p class="section-kicker">PANDUAN PRAKTIS</p><h1>Langkah yang bisa diikuti, bukan hanya dibaca.</h1><p class="lead">Panduan berorientasi tindakan untuk membantu tim menyiapkan informasi awal, meninjau dokumen, dan memahami urutan persiapan.</p><a class="button button-outline" href="/artikel/">Baca artikel →</a></div></section><section class="section"><div class="container">{entries.length?<div class="article-grid">{entries.map(e=><a class="article-card" href={`/panduan/${e.id.replace(/\.md$/, '')}/`}><div class="article-card-body"><p class="article-tag">{e.data.category??'Panduan'} · LANGKAH DEMI LANGKAH</p><h3>{e.data.title}</h3><p>{e.data.description}</p><span class="text-link">Ikuti panduan →</span></div></a>)}</div>:<p class="empty-state">Panduan sedang disiapkan.</p>}</div></section></BaseLayout>
