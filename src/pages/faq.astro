---
import {getEntry} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
const entry=await getEntry('pages','faq');
if(!entry) throw new Error('Missing frontmatter source: pages/faq.md');
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.socialImage} canonical={entry.data.canonical}>
<section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / FAQ</p><p class="section-kicker">PERTANYAAN UMUM</p><h1>{entry.data.heroTitle}</h1><p class="lead">{entry.data.heroIntro}</p></div></section>
<section class="section"><div class="container content-layout"><div style="max-width:850px"><FAQ items={entry.data.faqs} title="Pertanyaan seputar layanan"/><p>Belum menemukan jawaban? <a href="/kontak/">Diskusikan kebutuhan Anda →</a></p></div><RelatedLinks services={entry.data.relatedServices} pages={entry.data.relatedPages} articles={entry.data.relatedArticles} guides={entry.data.relatedGuides} currentSlug={Astro.url.pathname} title="Layanan dan panduan terkait"/></div></section>
</BaseLayout>
