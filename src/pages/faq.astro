---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
const items=[{question:'Apakah konsultan menerbitkan sertifikat SNI atau menetapkan nilai TKDN?',answer:'Tidak. Konsultan membantu persiapan dan pendampingan. Pengujian, verifikasi, penetapan hasil, atau penerbitan sertifikat dilakukan pihak berwenang sesuai skema dan ketentuan.'},{question:'Dokumen apa yang perlu disiapkan sebelum konsultasi?',answer:'Mulailah dari identitas perusahaan, jenis produk atau jasa, tujuan konsultasi, dan gambaran dokumen yang tersedia.'},{question:'Berapa biaya konsultasi?',answer:'Biaya bergantung pada ruang lingkup, kompleksitas, kondisi dokumen, jumlah varian, serta kebutuhan koordinasi atau pengujian.'},{question:'Berapa lama prosesnya?',answer:'Durasi dipengaruhi kesiapan data, kompleksitas ruang lingkup, kebutuhan perbaikan, jadwal pengujian atau verifikasi, serta proses pihak berwenang.'},{question:'Apakah nilai TKDN atau BMP bisa dijamin?',answer:'Tidak. Simulasi bersifat indikatif berdasarkan data dan metode yang relevan. Hasil resmi mengikuti proses dan ketentuan yang berlaku.'}];
---
<BaseLayout title="FAQ SNI, TKDN, dan BMP" description="Jawaban umum tentang ruang lingkup konsultasi, dokumen persiapan, biaya, durasi, dan batas kewenangan konsultan."><section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / FAQ</p><p class="section-kicker">PERTANYAAN UMUM</p><h1>Hal yang perlu diketahui sebelum memulai.</h1><p class="lead">Jawaban umum untuk membantu menyiapkan konsultasi. Kebutuhan akhir bergantung pada produk, skema, dan ketentuan yang berlaku.</p></div></section><section class="section"><div class="container" style="max-width:850px"><FAQ items={items} title="Pertanyaan seputar layanan"/><p>Belum menemukan jawaban? <a href="/kontak/">Diskusikan kebutuhan Anda →</a></p></div></section></BaseLayout>
