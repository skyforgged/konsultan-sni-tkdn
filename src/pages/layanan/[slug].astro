---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
export async function getStaticPaths(){const entries=await getCollection('services',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.slug??entry.id.replace(/\.md$/, '')},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);const pageUrl=Astro.site?new URL(Astro.url.pathname,Astro.site).toString():undefined;
const schema={'@context':'https://schema.org','@type':'Service',name:entry.title,description:entry.description,serviceType:entry.title,...(pageUrl?{url:pageUrl}:{}),provider:{'@type':'Organization',name:'Konsultan SNI–TKDN'}};
---
<BaseLayout title={entry.title} description={entry.description} image={entry.socialImage??entry.image} canonical={entry.canonical}><Fragment slot="head"><SeoJsonLd data={schema}/></Fragment><section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / <a href="/layanan/">Layanan</a> / {entry.title}</p><p class="section-kicker">{entry.eyebrow}</p><h1>{entry.title}</h1><p class="lead">{entry.intro}</p><a class="button" href="/kontak/">Diskusikan kebutuhan ↗</a></div></section><section class="section"><div class="container content-layout"><article class="prose"><h2>Siapa yang dapat terbantu?</h2><ul>{entry.audience.map(i=><li>{i}</li>)}</ul><h2>Ruang lingkup pendampingan</h2><Content/><h2>Contoh keluaran pekerjaan</h2><ul>{entry.deliverables.map(i=><li>{i}</li>)}</ul><h2>Tahapan kerja</h2><ol>{entry.process.map(s=><li><strong>{s.title}.</strong> {s.description}</li>)}</ol><FAQ items={entry.faqs} title="Pertanyaan tentang layanan ini"/><p><strong>Catatan ruang lingkup:</strong> pekerjaan final ditentukan setelah kebutuhan dan data awal ditinjau. Konsultan membantu persiapan; hasil resmi mengikuti proses pihak berwenang.</p><a class="button" href="/kontak/">Mulai konsultasi ↗</a></article><RelatedLinks services={entry.relatedServices} pages={entry.relatedPages} articles={entry.relatedArticles} guides={entry.relatedGuides} currentSlug={Astro.url.pathname} title="Layanan dan konten terkait"/></div></section></BaseLayout>