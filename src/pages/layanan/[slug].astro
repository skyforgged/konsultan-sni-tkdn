---
import {getCollection} from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('services', ({ data }) => !data.draft && data.status === 'active');
  return entries.map((entry) => ({
    params: { slug: entry.slug ?? entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  serviceType: entry.data.title,
  ...(pageUrl ? { url: pageUrl } : {}),
  provider: { '@type': 'Organization', name: siteConfig.name },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.socialImage ?? entry.data.image}
  canonical={entry.data.canonical}
>
  <Fragment slot="head"><SeoJsonLd data={schema} /></Fragment>
  <section class="content-hero">
    <div class="container">
      <p class="breadcrumbs"><a href={siteConfig.navigation[0].href}>{siteConfig.navigation[0].label}</a> / <a href={siteConfig.navigation[1].href}>{siteConfig.navigation[1].label}</a> / {entry.data.title}</p>
      <p class="section-kicker">{entry.data.eyebrow}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container content-layout">
      <article class="prose component-article-content">
        {entry.data.blocks.map((block) => <BlockRenderer block={block} />)}
      </article>
      <RelatedLinks
        services={entry.data.relatedServices}
        pages={entry.data.relatedPages}
        articles={entry.data.relatedArticles}
        guides={entry.data.relatedGuides}
        currentSlug={Astro.url.pathname}
        title={entry.data.relatedTitle}
      />
    </div>
  </section>
</BaseLayout>
