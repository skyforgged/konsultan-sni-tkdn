---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
export async function getStaticPaths(){const entries=await getCollection('services',({data})=>!data.draft);return entries.map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;const {Content}=await render(entry);const pageUrl=Astro.site?new URL(Astro.url.pathname,Astro.site).toString():undefined;
const schema={'@context':'https://schema.org','@type':'Service',name:entry.data.title,description:entry.data.description,serviceType:entry.data.title,...(pageUrl?{url:pageUrl}:{}),provider:{'@type':'Organization',name:'Konsultan SNI–TKDN'}};
---
<BaseLayout title={entry.data.title} description={entry.data.description}><Fragment slot="head"><SeoJsonLd data={schema}/></Fragment><section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / <a href="/layanan/">Layanan</a> / {entry.data.title}</p><p class="section-kicker">{entry.data.eyebrow}</p><h1>{entry.data.title}</h1><p class="lead">{entry.data.intro}</p><a class="button" href="/kontak/">Diskusikan kebutuhan ↗</a></div></section><section class="section"><div class="container content-layout"><article class="prose"><h2>Siapa yang dapat terbantu?</h2><ul>{entry.data.audience.map(i=><li>{i}</li>)}</ul><h2>Ruang lingkup pendampingan</h2><Content/><h2>Contoh keluaran pekerjaan</h2><ul>{entry.data.deliverables.map(i=><li>{i}</li>)}</ul><h2>Tahapan kerja</h2><ol>{entry.data.process.map(s=><li><strong>{s.title}.</strong> {s.description}</li>)}</ol><FAQ items={entry.data.faqs} title="Pertanyaan tentang layanan ini"/><p><strong>Catatan ruang lingkup:</strong> pekerjaan final ditentukan setelah kebutuhan dan data awal ditinjau. Konsultan membantu persiapan; hasil resmi mengikuti proses pihak berwenang.</p><a class="button" href="/kontak/">Mulai konsultasi ↗</a></article><aside class="article-aside"><h2>Layanan lainnya</h2>{[{label:'Konsultan SNI',href:'/layanan/konsultan-sni/'},{label:'Konsultan TKDN',href:'/layanan/konsultan-tkdn/'},{label:'Konsultan BMP',href:'/layanan/konsultan-bmp/'},{label:'Layanan Terpadu',href:'/layanan/layanan-terpadu/'}].filter(i=>i.href!==Astro.url.pathname).map(i=><a href={i.href}>{i.label} →</a>)}<h2 style="margin-top:25px">Panduan terkait</h2><a href="/panduan/">Baca panduan persiapan →</a></aside></div></section></BaseLayout>
