---
import { getCollection } from 'astro:content';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const entries = await getCollection('services', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug ?? entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const blocks = entry.data.blocks;
const heroBlock = blocks.find((block) => block.component === 'page-header');
const contentBlocks = blocks.filter((block) => block.component !== 'page-header');
const processBlock = blocks.find((block) => block.component === 'process-timeline');
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.description,
  serviceType: entry.data.title,
  ...(pageUrl ? { url: pageUrl } : {}),
  provider: { '@type': 'Organization', name: siteConfig.name },
};
const processProps = (processBlock?.props ?? processBlock) as
  | { items?: Array<{ title?: string; description?: string }>; heading?: string }
  | undefined;
const processSteps = processProps?.items ?? [];
const howToSchema = processSteps.length >= 2 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: processProps?.heading ?? `Tahapan ${entry.data.title}`,
  description: entry.data.description,
  step: processSteps.map((item, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: item.title,
    text: item.description,
  })),
} : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.socialImage ?? entry.data.image}
  canonical={entry.data.canonical}
  brandCopy={`${siteConfig.name} menyediakan ${entry.data.title.startsWith('Layanan') ? entry.data.title : 'Layanan ' + entry.data.title}`}
>
  <Fragment slot="head">
    <SeoJsonLd data={schema} />
    {howToSchema && <SeoJsonLd data={howToSchema} />}
  </Fragment>
  <section class="content-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="breadcrumbs"><a href={siteConfig.navigation[0].href}>{siteConfig.navigation[0].label}</a> / <a href={siteConfig.navigation[1].href}>{siteConfig.navigation[1].label}</a> / {entry.data.title}</p>
        <p class="eyebrow">{entry.data.eyebrow}</p>
        <h1>{entry.data.title}</h1>
        <p class="hero-lead">{entry.data.description}</p>
        <div class="hero-actions">
          <a class="button button-light" href="/kontak/">Diskusikan kebutuhan Anda ↗</a>
          <a class="button" href="/layanan/" style="background:transparent;border-color:#ffffff55">Jelajahi layanan →</a>
        </div>
      </div>
      <div class="hero-visual" role="img" aria-label={`Ilustrasi ${entry.data.title}`}>
        {(entry.data.image ?? entry.data.socialImage) && (
          <figure class="article-featured-image">
            <img src={entry.data.image ?? entry.data.socialImage} alt={entry.data.imageAlt ?? entry.data.title} loading="eager" width="1200" height="630" />
          </figure>
        )}
        {heroBlock && <BlockRenderer block={heroBlock} />}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container content-layout">
      <article class="prose component-article-content">
        {contentBlocks.map((block) => <BlockRenderer block={block} />)}
      </article>
    </div>
  </section>
</BaseLayout>
