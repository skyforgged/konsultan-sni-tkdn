---
import {getCollection,getEntry} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import PageBlocks from '../../components/PageBlocks.astro';
const page=await getEntry('pages','layanan');
if(!page) throw new Error('Missing frontmatter source: pages/layanan.md');
const services = (await getCollection('services',({data})=>!data.draft && data.status!=='inactive')).sort((a,b)=>(a.data.order??999)-(b.data.order??999)).map((e,i)=>({title:e.data.title,description:e.data.description,href:`/layanan/${e.slug??e.id}/`,eyebrow:e.data.eyebrow,number:String(i+1).padStart(2,'0')}));
---
<BaseLayout title={page.data.title} description={page.data.description} image={page.data.socialImage} canonical={page.data.canonical}>
<section class="content-hero"><div class="container"><p class="breadcrumbs"><a href="/">Beranda</a> / Layanan</p><p class="section-kicker">KATALOG LAYANAN</p><h1>{page.data.heroTitle}</h1><p class="lead">{page.data.heroIntro}</p></div></section>
<section class="section"><div class="container"><div class="service-grid">{services.map(s=><ServiceCard {...s}/>)}</div></div></section>
<PageBlocks blocks={page.data.blocks}/>
</BaseLayout>