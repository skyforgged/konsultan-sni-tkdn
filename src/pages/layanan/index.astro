const services=[{title:'Konsultan SNI',description:'Identifikasi standar, pemeriksaan kesiapan, persiapan dokumen, dan pendampingan proses sertifikasi.',href:'/layanan/konsultan-sni/',eyebrow:'STANDAR PRODUK',number:'01'},{title:'Konsultan TKDN',description:'Pemetaan komponen lokal, penataan data biaya dan bukti, serta simulasi awal.',href:'/layanan/konsultan-tkdn/',eyebrow:'KOMPONEN DALAM NEGERI',number:'02'},{title:'Konsultan BMP',description:'Pemetaan kebutuhan, peninjauan dokumen, dan pendampingan sesuai aturan yang berlaku.',href:'/layanan/konsultan-bmp/',eyebrow:'BOBOT MANFAAT PERUSAHAAN',number:'03'},{title:'Layanan Terpadu',description:'Rencana persiapan terpadu untuk perusahaan dengan beberapa kebutuhan.',href:'/layanan/layanan-terpadu/',eyebrow:'TERINTEGRASI',number:'04'}];
