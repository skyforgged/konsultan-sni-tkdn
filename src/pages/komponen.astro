---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import ArticleCard from '../components/shared/ArticleCard.astro';
import ArticleRelatedArticles from '../components/shared/ArticleRelatedArticles.astro';
import Badge from '../components/shared/Badge.astro';
import Button from '../components/shared/Button.astro';
import Dropdown from '../components/shared/Dropdown.astro';
import Modal from '../components/shared/Modal.astro';
import PageUpdatedArticles from '../components/shared/PageUpdatedArticles.astro';
import RelatedArticles from '../components/shared/RelatedArticles.astro';
import TestimonialGrid from '../components/shared/TestimonialGrid.astro';
const examples = [
  {component:'card',heading:'Kartu informasi',text:'Ringkasan informasi penting disajikan dalam kartu yang konsisten.'},
  {component:'faq',heading:'Pertanyaan umum',items:[{question:'Apa fungsi komponen FAQ?',answer:'Menampilkan pertanyaan dan jawaban yang relevan.'}]},
  {component:'cta',heading:'Butuh pendampingan?',text:'Diskusikan kebutuhan SNI, TKDN, atau BMP bersama tim kami.',ctaHref:'/kontak/',ctaLabel:'Hubungi konsultan'},
  {component:'table',heading:'Contoh tabel persyaratan',headers:['Dokumen','Tujuan'],rows:[{title:'Data produk',text:'Identifikasi produk'},{title:'Dokumen perusahaan',text:'Verifikasi pemohon'}]},
  {component:'note',heading:'Catatan penting',text:'Persyaratan final mengikuti skema sertifikasi dan ketentuan yang berlaku.'},
  {component:'steps',heading:'Tahapan kerja',items:[{title:'Pemetaan kebutuhan',text:'Identifikasi skema dan ruang lingkup.'},{title:'Pemeriksaan dokumen',text:'Tinjau kelengkapan data.'}]},
  {component:'stats',heading:'Ringkasan layanan',items:[{title:'SNI',text:'Standar produk'},{title:'TKDN',text:'Komponen dalam negeri'}]},
  {component:'glossary',heading:'Istilah utama',items:[{title:'SNI',text:'Standar Nasional Indonesia.'},{title:'TKDN',text:'Tingkat Komponen Dalam Negeri.'}]},
  {component:'quote',heading:'Prinsip pendampingan',quote:'Persiapan yang tertata membantu proses berjalan lebih jelas.',text:'Persiapan yang tertata membantu proses berjalan lebih jelas.'},
  {component:'section',heading:'Bagian artikel',content:[{text:'Bagian isi artikel dirender melalui komponen semantik yang dapat digunakan ulang.'}]},
  {component:'process-timeline',heading:'Alur proses',steps:[{title:'Konsultasi awal',text:'Pemetaan kebutuhan.'},{title:'Analisis',text:'Pemeriksaan data.'}]},
  {component:'checklist-card',heading:'Checklist awal',items:[{title:'Identitas perusahaan'},{title:'Informasi produk'},{title:'Dokumen pendukung'}]},
  {component:'comparison-table',heading:'Perbandingan skema',headers:['Aspek','SNI','TKDN'],rows:[{title:'Fokus',text:'Standar produk · Kandungan lokal'}]},
  {component:'document-list',heading:'Dokumen yang disiapkan',items:[{title:'Data legalitas',text:'Dokumen identitas perusahaan.'},{title:'Spesifikasi produk',text:'Data teknis produk.'}]},
  {component:'image-panel',heading:'Ilustrasi proses',image:'/images/og-default.svg',imageAlt:'Ilustrasi konsultasi SNI dan TKDN',text:'Visual pendukung dapat disertakan pada bagian konten.'},
  {component:'feature-card-grid',heading:'Keunggulan pendampingan',items:[{title:'Terstruktur',text:'Tahapan dan keluaran jelas.'},{title:'Transparan',text:'Ruang lingkup dibahas sejak awal.'}]},
  {component:'stats-grid',heading:'Area konsultasi',items:[{title:'SNI',text:'Standar Nasional Indonesia'},{title:'TKDN',text:'Tingkat Komponen Dalam Negeri'},{title:'BMP',text:'Bobot Manfaat Perusahaan'}]},
  {component:'source-links',heading:'Sumber rujukan',items:[{title:'Kontak konsultan',href:'/kontak/',text:'Diskusikan kebutuhan secara langsung.'}]},
  {component:'contact-panel',heading:'Hubungi tim',text:'Siapkan ringkasan produk dan kebutuhan sertifikasi.',ctaHref:'/kontak/',ctaLabel:'Halaman kontak'},
  {component:'page-header',eyebrow:'PUSAT KOMPONEN',heading:'Header konten',text:'Komponen header untuk halaman informasi.'},
  {component:'home-hero',eyebrow:'KONSULTAN SNI–TKDN',heading:'Hero berorientasi kebutuhan',text:'Pendampingan untuk persiapan sertifikasi dan pemenuhan persyaratan.'},
  {component:'service-list',heading:'Contoh layanan',items:[{title:'Konsultasi SNI',text:'Pemetaan kebutuhan standar.'},{title:'Konsultasi TKDN',text:'Persiapan data kandungan lokal.'}]},
  {component:'home-process',heading:'Proses pendampingan',items:[{title:'Pemetaan',text:'Identifikasi kebutuhan.'},{title:'Persiapan',text:'Penataan dokumen.'}]},
  {component:'article-list',heading:'Artikel terkait',items:[{title:'Mengenal SNI',text:'Dasar memahami standar produk.',href:'/artikel/'}]},
  {component:'home-cta',heading:'Mulai dengan konsultasi',text:'Tentukan langkah berikutnya berdasarkan kondisi produk dan perusahaan.',ctaHref:'/kontak/',ctaLabel:'Konsultasi'},
  {component:'not-found',heading:'Konten tidak ditemukan',text:'Kembali ke halaman utama atau jelajahi layanan kami.',ctaHref:'/',ctaLabel:'Kembali ke beranda'}
];
const sampleArticles = [
  {id:'demo-1',slug:'perbedaan-konsultasi-pengujian-sertifikasi',data:{id:'demo-1',slug:'perbedaan-konsultasi-pengujian-sertifikasi',title:'Perbedaan konsultasi, pengujian, dan sertifikasi',description:'Contoh ringkasan artikel untuk memeriksa kartu artikel reusable.',category:'SNI',pubDate:new Date('2026-10-22T00:00:01Z')}},
  {id:'demo-2',slug:'perbedaan-konsultasi-pengujian-sertifikasi',data:{id:'demo-2',slug:'perbedaan-konsultasi-pengujian-sertifikasi',title:'Persiapan awal sertifikasi SNI',description:'Contoh artikel terkait untuk menguji pemilihan artikel berdasarkan ID.',category:'Panduan',pubDate:new Date('2026-10-22T00:00:03Z')}}
];
---
<BaseLayout title="Katalog Komponen" description="Katalog internal untuk verifikasi semua komponen konten reusable Konsultan SNI–TKDN." noindex={true}>
  <section class="content-hero"><div class="container"><p class="section-kicker">INTERNAL QUALITY CHECK</p><h1>Katalog Komponen Reusable</h1><p class="lead">Seluruh komponen konsultan-slf dipertahankan dengan nama file yang sama dan gaya visual forest/lime Konsultan SNI–TKDN.</p><p><strong>{examples.length + 9} jenis komponen</strong> diuji di halaman ini. Data testimoni hanya simulasi.</p></div></section>
  <section class="section"><div class="container component-catalog">{examples.map(block=><BlockRenderer block={block}/>)}</div></section>
  <section class="section section-white"><div class="container">
    <p class="section-kicker">SHARED UI COMPONENTS</p><h2>Komponen antarmuka reusable</h2>
    <div class="component-catalog__row"><Badge variant="primary">SNI</Badge><Badge variant="success" size="sm">Dokumen siap ditinjau</Badge><Badge variant="warning">Perlu verifikasi</Badge><Badge variant="info">Informasi</Badge></div>
    <div class="component-catalog__row"><Button href="/kontak/">Hubungi konsultan</Button><Button href="/layanan/" variant="outline">Lihat layanan</Button><Button variant="secondary" size="sm">Aksi sekunder</Button></div>
    <div class="component-catalog__row"><Dropdown label="Navigasi tambahan"><a href="/artikel/">Artikel</a><a href="/panduan/">Panduan</a><a href="/faq/">FAQ</a></Dropdown><button class="button button-outline" type="button" data-modal-open="tkdn-component-demo-modal">Buka modal contoh</button></div>
    <Modal id="tkdn-component-demo-modal" title="Modal komponen reusable" size="md"><p>Modal native dialog untuk menampilkan informasi tambahan tanpa meninggalkan halaman.</p><p class="small-note">Tekan tombol tutup atau klik area gelap untuk menutup dialog.</p></Modal>
    <div class="component-catalog__row"><ArticleCard article={sampleArticles[0]} /><ArticleRelatedArticles articles={sampleArticles} relatedIds={['demo-2']} heading="Artikel yang dipilih berdasarkan ID" /></div>
    <RelatedArticles heading="Rujukan yang relevan" items={[{title:'Layanan konsultasi SNI',href:'/layanan/konsultan-sni/',description:'Informasi layanan pendampingan SNI.'},{title:'Pertanyaan umum',href:'/faq/',description:'Jawaban awal sebelum konsultasi.'}]} />
  </div></section>
  <PageUpdatedArticles heading="Artikel terbaru (data aktual)" description="Komponen ini mengambil artikel aktif dari koleksi konten, bukan data contoh." limit={3} />
  <TestimonialGrid id="testimoni-demo" title="Contoh tampilan testimoni" illustrative={true} items={[{quote:'Alur kerja ditampilkan secara bertahap dan mudah dipahami.',name:'Contoh nama (simulasi)',industry:'Contoh perusahaan'}]} />
</BaseLayout>
<style>
.component-catalog__row{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin:1.2rem 0}.component-catalog__row>article,.component-catalog__row>section{flex:1 1 270px;min-width:0}
</style>
